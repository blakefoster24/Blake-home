frosted glass:

    light:
      custom-bg: *bg #secondary-background-color
      custom-active: *active #primary-color
      custom-contrast: *contrast #primary-text-color
      custom-radius: 20px
      custom-button-border: 1px solid rgba(255, 255, 255, 0.2)
      custom-border: 1px solid rgba(255, 255, 255, 0.2)

    dark:
      custom-bg: *dark-bg #secondary-background-color
      custom-active: *dark-active #primary-color
      custom-contrast: *dark-contrast #primary-text-color
      custom-radius: 20px
      custom-button-border: 1px solid rgba(255, 255, 255, 0.2)
      custom-border: .5px solid rgba(255, 255, 255, 0.2)
     
      ha-dialog-surface-backdrop-filter: 'blur(8px)'                  # 1.2 Glass – same blur as cards
      ha-dialog-surface-background: 'rgba(0, 0, 0, 0.3)'
      dialog-box-shadow: '3px 3px 0.5px -3.5px rgba(255, 255, 255, 0.30) inset, -2px -2px 0.5px -2px rgba(255, 255, 255, 0.30) inset, 0 0 8px 1px rgba(255, 255, 255, 0.10) inset, 0 0 2px 0 rgba(0, 0, 0, 0.10)'
      ha-dialog-scrim-backdrop-filter: 'none'
      paper-dialog-background-color: 'rgba(55, 55, 55, 0.8)'

      card-mod-more-info-yaml: |
        ha-more-info-info$: |
          :host {
            color: rgba(234, 235, 238, 0.98) !important;
          }

